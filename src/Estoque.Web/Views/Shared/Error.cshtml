@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
    if (User.Identity?.IsAuthenticated != true) { Layout = "_LayoutLogin"; }
}
<div class="card mx-auto" style="max-width: 560px">
    <div class="card-body text-center p-4">
        <i class="bi bi-exclamation-octagon text-danger" style="font-size: 2.5rem"></i>
        <h1 class="h4 mt-2">Algo deu errado</h1>
        <p class="text-muted">Ocorreu um erro inesperado. Tente novamente; se o problema continuar, informe o código abaixo ao responsável pelo sistema.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small"><code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar ao início</a>
    </div>
</div>
