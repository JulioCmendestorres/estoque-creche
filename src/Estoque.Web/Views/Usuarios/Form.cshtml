@model UsuarioFormViewModel
@{
    var i = Model.Input;
    var novo = i.Id == 0;
    ViewData["Title"] = novo ? "Novo usuário" : "Editar usuário";
}
<div class="page-header"><h1>@ViewData["Title"]</h1></div>
<div class="card" style="max-width: 640px">
    <div class="card-body">
        <form asp-action="@(novo ? "Criar" : "Editar")" asp-route-id="@(novo ? null : i.Id)" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            @if (i.Master)
            {
                <div class="alert alert-secondary small py-2">
                    <i class="bi bi-shield-check"></i> Este é o usuário <strong>master</strong>: tem todas as permissões e escolhe a unidade no topo da tela.
                    A unidade abaixo é só a que abre ao entrar.
                </div>
            }
            <div class="mb-3">
                <label asp-for="Input.Nome" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Input.Nome" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Nome" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Input.Email" type="email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                @if (!i.Master)
                {
                    <div class="col-md-6">
                        <label asp-for="Input.PerfilId" class="form-label"></label> <span class="text-danger">*</span>
                        <select asp-for="Input.PerfilId" class="form-select">
                            <option value="">Escolha…</option>
                            @foreach (var p in Model.Perfis)
                            {
                                <option value="@p.Id">@p.Nome@(p.Ativo ? "" : " (inativo)")</option>
                            }
                        </select>
                        <span asp-validation-for="Input.PerfilId" class="text-danger small"></span>
                    </div>
                }
                <div class="col-md-6">
                    <label asp-for="Input.UnidadeId" class="form-label">@(i.Master ? "Unidade inicial" : "Unidade")</label> <span class="text-danger">*</span>
                    <select asp-for="Input.UnidadeId" class="form-select">
                        <option value="0">Escolha…</option>
                        @foreach (var u in Model.Unidades)
                        {
                            <option value="@u.Id">@u.Nome (@(u.Tipo == TiposUnidade.Matriz ? "Matriz" : "Filial"))@(u.Ativo ? "" : " — inativa")</option>
                        }
                    </select>
                    <span asp-validation-for="Input.UnidadeId" class="text-danger small"></span>
                </div>
            </div>
            @if (novo)
            {
                <p class="small text-muted">Ao salvar, o sistema mostra uma <strong>senha temporária</strong>. A pessoa troca a senha no primeiro acesso.</p>
            }
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
