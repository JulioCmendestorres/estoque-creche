@model ItensIndexViewModel
@{
    ViewData["Title"] = "Itens";
    var podeEditar = Acesso.Tem(Permissoes.CadastroItens);
    var podeUnidade = Acesso.Tem(Permissoes.EstoqueItensUnidade);
    var unidade = Acesso.UnidadeNome;
}
<div class="page-header">
    <h1>Itens</h1>
    @if (podeEditar)
    {
        <a asp-action="Criar" class="btn btn-primary ms-auto"><i class="bi bi-plus-lg"></i> Novo item</a>
    }
</div>

<form method="get" class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small" for="busca">Buscar</label>
            <input id="busca" name="busca" value="@Model.Busca" class="form-control" placeholder="Nome ou código" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="categoriaId">Categoria</label>
            <select id="categoriaId" name="categoriaId" class="form-select">
                <option value="">Todas</option>
                @foreach (var c in Model.Categorias)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.CategoriaId)">@c.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="inativos" name="inativos" value="true" checked="@Model.MostrarInativos" />
                <label class="form-check-label small" for="inativos">Mostrar inativos</label>
            </div>
        </div>
        <div class="col-md-2 d-grid"><button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Filtrar</button></div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
            <tr>
                <th>Código</th><th>Nome</th><th>Categoria</th><th>Unid.</th>
                <th class="text-end">Preço est.</th><th class="text-end">Saldo</th><th class="text-end">Mínimo</th><th>Nesta unidade</th><th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Itens.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">Nenhum item encontrado.</td></tr>
            }
            @foreach (var l in Model.Itens)
            {
                <tr class="@(l.Item.Ativo ? "" : "text-muted")">
                    <td class="small text-nowrap">@l.Item.CodigoInterno</td>
                    <td>
                        @l.Item.Nome
                        @if (!l.Item.Ativo) { <span class="badge text-bg-secondary ms-1" title="Inativo no catálogo: vale para todas as unidades">inativo em todas</span> }
                    </td>
                    <td>@l.Item.Categoria?.Nome</td>
                    <td>@l.Item.UnidadeMedida</td>
                    <td class="text-end">@(l.Item.PrecoEstimado is decimal p ? Formatos.Moeda(p) : "—")</td>
                    <td class="text-end @(l.Alerta ? "text-danger fw-semibold" : "")">
                        @l.Saldo
                        @if (l.Alerta) { <i class="bi bi-exclamation-triangle-fill" title="Abaixo do mínimo"></i> }
                    </td>
                    <td class="text-end">@l.Minimo</td>
                    <td class="text-nowrap">
                        @if (!l.Item.Ativo)
                        {
                            <span class="text-muted small">—</span>
                        }
                        else
                        {
                            <span class="badge @(l.AtivoNaUnidade ? "text-bg-success" : "text-bg-secondary")">@(l.AtivoNaUnidade ? "Ativo" : "Desativado")</span>
                            @if (podeUnidade)
                            {
                                <form asp-action="AlterarStatusUnidade" asp-route-id="@l.Item.Id" method="post" class="d-inline"
                                      data-confirmar="@(l.AtivoNaUnidade ? $"Desativar \"{l.Item.Nome}\" só em {unidade}? As outras unidades continuam usando o item." : "")">
                                    <input type="hidden" name="ativo" value="@(!l.AtivoNaUnidade ? "true" : "false")" />
                                    <button class="btn btn-sm btn-link p-0 ms-1 align-baseline" title="@(l.AtivoNaUnidade ? $"Desativar só em {unidade}" : $"Reativar em {unidade}")">
                                        @(l.AtivoNaUnidade ? "desativar" : "reativar")
                                    </button>
                                </form>
                            }
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        @if (podeEditar)
                        {
                            <a asp-action="Editar" asp-route-id="@l.Item.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="AlterarStatus" asp-route-id="@l.Item.Id" method="post" class="d-inline"
                                  data-confirmar="@(l.Item.Ativo ? $"Inativar \"{l.Item.Nome}\" em TODAS as unidades? Só é possível com saldo zerado em todas." : $"Reativar \"{l.Item.Nome}\" no catálogo?")">
                                <input type="hidden" name="ativo" value="@(!l.Item.Ativo ? "true" : "false")" />
                                <button class="btn btn-sm @(l.Item.Ativo ? "btn-outline-danger" : "btn-outline-success")" title="@(l.Item.Ativo ? "Inativar em todas as unidades" : "Reativar no catálogo")">
                                    <i class="bi @(l.Item.Ativo ? "bi-trash" : "bi-arrow-counterclockwise")"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">
    Saldo, mínimo e "Nesta unidade" referem-se a <strong>@unidade</strong>. "Desativar" tira o item só desta unidade;
    a lixeira inativa o item no catálogo de todas as unidades (exige saldo zerado em todas).
</p>
