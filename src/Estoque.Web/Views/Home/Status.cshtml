@model int
@{
    ViewData["Title"] = Model == 404 ? "Não encontrado" : "Erro";
    if (User.Identity?.IsAuthenticated != true) { Layout = "_LayoutLogin"; }
    var mensagem = Model switch
    {
        404 => "A página ou o registro solicitado não foi encontrado.",
        403 => "Você não tem permissão para acessar este recurso.",
        _ => "Não foi possível concluir a solicitação.",
    };
}
<div class="card mx-auto" style="max-width: 520px">
    <div class="card-body text-center p-4">
        <div class="display-6 text-muted">@Model</div>
        <p class="mt-2">@mensagem</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar ao início</a>
    </div>
</div>
