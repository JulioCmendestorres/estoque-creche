@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var unidade = Acesso.UnidadeNome;
}
<div class="page-header">
    <h1>Dashboard</h1>
    <span class="badge text-bg-light border">@unidade</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-success-subtle text-success"><i class="bi bi-gift"></i></span>
            <div><div class="stat-value">@Model.DoacoesRecebidas</div><div class="text-muted small">Doações recebidas</div></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-box-seam"></i></span>
            <div>
                <div class="stat-value">@Model.ItensEmEstoque</div>
                <div class="text-muted small">Itens em estoque <span class="d-block">(@Model.ItensDistintos produtos)</span></div>
            </div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-people"></i></span>
            <div><div class="stat-value">@Model.Beneficiarios</div><div class="text-muted small">Beneficiários</div></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-heart"></i></span>
            <div><div class="stat-value">@Model.DoacoesRealizadas</div><div class="text-muted small">Doações realizadas</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle text-danger"></i> Alertas de estoque baixo
            </div>
            <div class="card-body p-0">
                @if (Model.Alertas.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">Nenhum item abaixo do mínimo nesta unidade.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead><tr><th>Item</th><th class="text-end">Atual</th><th class="text-end">Mínimo</th></tr></thead>
                            <tbody>
                            @foreach (var a in Model.Alertas)
                            {
                                <tr>
                                    <td>@a.Item!.Nome</td>
                                    <td class="text-end text-danger fw-semibold">@a.QuantidadeAtual @a.Item.UnidadeMedida</td>
                                    <td class="text-end">@a.QuantidadeMinima</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-clock-history"></i> Últimas movimentações
                <a asp-controller="Estoque" asp-action="Index" asp-route-aba="movimentacoes" class="ms-auto small">Ver todas</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UltimasMovimentacoes.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">Nenhuma movimentação registrada.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead><tr><th>Data</th><th>Tipo</th><th>Item</th><th class="text-end">Qtd.</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var m in Model.UltimasMovimentacoes)
                            {
                                <tr class="@(m.Status == StatusMovimentacao.Cancelada ? "text-decoration-line-through text-muted" : "")">
                                    <td class="text-nowrap">@Formatos.Data(m.DataMovimentacao)</td>
                                    <td><span class="badge @(m.EhEntrada ? "badge-entrada" : "badge-saida")">@TiposMovimentacao.Rotulo(m.TipoMovimentacao)</span></td>
                                    <td>@m.Item?.Nome</td>
                                    <td class="text-end">@(m.EhEntrada ? "+" : "−")@m.Quantidade</td>
                                    <td class="small">@m.Status</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
