@model DashboardViewModel
@{
    ViewData["Title"] = "Painel";
    var hoje = Tempo.Hoje.ToString("dddd, d 'de' MMMM", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
}
<div class="page-header">
    <h1>Painel</h1>
    <p class="page-subtitulo">@(char.ToUpper(hoje[0]) + hoje[1..]) · @Acesso.UnidadeNome</p>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                Itens abaixo do mínimo
                @if (Model.Alertas.Count > 0) { <span class="badge text-bg-danger">@Model.Alertas.Count</span> }
            </div>
            @if (Model.Alertas.Count == 0)
            {
                <p class="vazio">Nenhum item abaixo do mínimo nesta unidade.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Item</th><th class="text-end">Atual</th><th class="text-end">Mínimo</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.Alertas)
                        {
                            <tr>
                                <td><a asp-controller="Estoque" asp-action="Index" asp-route-busca="@a.Item!.Nome" title="Ver no estoque">@a.Item!.Nome</a></td>
                                <td class="text-end text-danger fw-semibold text-nowrap">@a.QuantidadeAtual @a.Item.UnidadeMedida</td>
                                <td class="text-end">@a.QuantidadeMinima</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Resumo da unidade</div>
            <dl class="resumo">
                <div>
                    <dt>Itens em estoque <small>@Model.ItensDistintos produtos diferentes</small></dt>
                    <dd>@Model.ItensEmEstoque</dd>
                </div>
                <div><dt>Doações recebidas</dt><dd>@Model.DoacoesRecebidas</dd></div>
                <div><dt>Doações realizadas</dt><dd>@Model.DoacoesRealizadas</dd></div>
                <div><dt>Beneficiários</dt><dd>@Model.Beneficiarios</dd></div>
            </dl>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center gap-2">
        Últimas movimentações
        <a asp-controller="Estoque" asp-action="Index" asp-route-aba="movimentacoes" class="ms-auto fw-normal">Ver todas</a>
    </div>
    @if (Model.UltimasMovimentacoes.Count == 0)
    {
        <p class="vazio">Nenhuma movimentação registrada.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>Data</th><th>Tipo</th><th>Item</th><th class="text-end">Qtd.</th><th>Responsável</th></tr></thead>
                <tbody>
                @foreach (var m in Model.UltimasMovimentacoes)
                {
                    var cancelada = m.Status == StatusMovimentacao.Cancelada;
                    <tr class="@(cancelada ? "text-muted" : "")">
                        <td class="text-nowrap">@Formatos.Data(m.DataMovimentacao)</td>
                        <td><span class="badge @(m.EhEntrada ? "badge-entrada" : "badge-saida")">@TiposMovimentacao.Rotulo(m.TipoMovimentacao)</span></td>
                        <td>
                            @m.Item?.Nome
                            @if (cancelada) { <span class="badge text-bg-secondary ms-1">Cancelada</span> }
                        </td>
                        <td class="text-end text-nowrap">@(m.EhEntrada ? "+" : "−")@m.Quantidade @m.Item?.UnidadeMedida</td>
                        <td>@m.Responsavel?.Nome</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
