@{
    ViewData["Title"] = "Sobre a ONG";
}
<div class="page-header"><h1>Sobre a ONG</h1></div>
<div class="card" style="max-width: 760px">
    <div class="card-body">
        <h2 class="h5">Creche Fraternidade Menino Jesus</h2>
        <p class="text-muted mb-2">Santo André – SP</p>
        <p>
            Este sistema substitui os cadernos e planilhas de controle de estoque e doações da creche:
            cadastro de itens, entradas por doação ou compra, saídas para uso interno, doação ou avaria,
            saldo por unidade (Matriz e Filial) e alertas de estoque mínimo.
        </p>
        <p class="text-muted small mb-0">
            Conteúdo institucional (história, missão, contatos) será fornecido pela creche.
        </p>
    </div>
</div>
