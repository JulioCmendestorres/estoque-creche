@model List<UnidadeMedidaLinha>
@{
    ViewData["Title"] = "Unidades de medida";
    var podeEditar = (await Autorizacao.AuthorizeAsync(User, Policies.PodeEditar)).Succeeded;
}
<div class="page-header">
    <h1>Unidades de medida</h1>
    @if (podeEditar)
    {
        <a asp-action="Criar" class="btn btn-primary ms-auto"><i class="bi bi-plus-lg"></i> Nova unidade</a>
    }
</div>
<div class="card" style="max-width: 860px">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Sigla</th><th>Nome</th><th class="text-end">Itens</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in Model)
            {
                var u = l.Unidade;
                <tr class="@(u.Ativo ? "" : "text-muted")">
                    <td><code>@u.Codigo</code></td>
                    <td>@u.Descricao</td>
                    <td class="text-end">@l.ItensUsando</td>
                    <td>@(u.Ativo ? "Ativa" : "Inativa")</td>
                    <td class="text-end text-nowrap">
                        @if (podeEditar)
                        {
                            <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="AlterarStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                <input type="hidden" name="ativo" value="@(!u.Ativo ? "true" : "false")" />
                                <button class="btn btn-sm @(u.Ativo ? "btn-outline-danger" : "btn-outline-success")" title="@(u.Ativo ? "Inativar" : "Reativar")">
                                    <i class="bi @(u.Ativo ? "bi-slash-circle" : "bi-arrow-counterclockwise")"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">
    Unidades inativas não aparecem no cadastro de novos itens; os itens que já a usam continuam funcionando.
</p>
