@{
    ViewData["Title"] = "Acesso negado";
    if (User.Identity?.IsAuthenticated != true) { Layout = "_LayoutLogin"; }
}
<div class="card mx-auto" style="max-width: 520px">
    <div class="card-body text-center p-4">
        <i class="bi bi-shield-x text-danger" style="font-size: 2.5rem"></i>
        <h1 class="h4 mt-2">Acesso negado</h1>
        <p class="text-muted">Seu perfil não tem permissão para esta ação. Fale com o administrador se precisar desse acesso.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar ao início</a>
    </div>
</div>
