@model LoginInput
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutLogin";
}
<div class="login-card">
    <div class="login-org">
        <strong>Creche Fraternidade Menino Jesus</strong>
        <span>Estoque e doações</span>
    </div>
    <h1 class="mb-1">Entrar</h1>
    <p class="text-muted mb-4">Use o e-mail e a senha que o responsável pelo sistema criou para você.</p>
    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Senha" class="form-label"></label>
            <input asp-for="Senha" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Senha" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Entrar</button>
    </form>
    <p class="text-muted small mt-4 mb-0">Esqueceu a senha? Peça ao responsável pelo sistema para redefini-la.</p>
</div>
