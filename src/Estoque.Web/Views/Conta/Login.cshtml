@model LoginInput
@{
    ViewData["Title"] = "Entrar";
    ViewData["TelaCheia"] = true;
    Layout = "_LayoutLogin";
}
<div class="login-split">
    <section class="login-aside" aria-label="Sobre o sistema">
        <div class="login-marca">
            <span class="marca-selo" aria-hidden="true"><i class="bi bi-box2-heart"></i></span>
            <div>
                <strong>Estoque &amp; Doações</strong>
                <small>Creche Fraternidade Menino Jesus</small>
            </div>
        </div>
        <div class="login-texto">
            <h2>Cada doação registrada chega a quem precisa.</h2>
            <p>Controle o que entra e o que sai da matriz e da filial, acompanhe o estoque mínimo e preste contas com poucos cliques.</p>
            <ul class="login-pontos">
                <li><i class="bi bi-arrow-down-circle" aria-hidden="true"></i> Entradas por doação ou compra</li>
                <li><i class="bi bi-bell" aria-hidden="true"></i> Alerta de estoque baixo por unidade</li>
                <li><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Relatórios em PDF e planilha</li>
            </ul>
        </div>
    </section>

    <div class="login-main">
        <div class="login-card">
            <h1 class="mb-1">Entrar</h1>
            <p class="text-muted mb-4">Use o e-mail e a senha que o responsável pelo sistema criou para você.</p>
            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Senha" class="form-label"></label>
                    <input asp-for="Senha" class="form-control form-control-lg" autocomplete="current-password" />
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Entrar <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
            </form>
            <p class="text-muted small mt-4 mb-0"><i class="bi bi-shield-lock" aria-hidden="true"></i> Esqueceu a senha? Peça ao responsável pelo sistema para redefini-la.</p>
        </div>
    </div>
</div>
