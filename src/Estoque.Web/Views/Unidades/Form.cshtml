@model UnidadeInput
@{
    var novo = Model.Id == 0;
    ViewData["Title"] = novo ? "Nova unidade" : "Renomear unidade";
}
<div class="page-header"><h1>@ViewData["Title"]</h1></div>
<div class="card" style="max-width: 600px">
    <div class="card-body">
        <form asp-action="@(novo ? "Criar" : "Editar")" asp-route-id="@(novo ? null : Model.Id)" method="post" novalidate>
            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Nome" class="form-control" maxlength="100" autofocus placeholder="ex.: Sede, Unidade Vila Alice" />
                <div class="form-text">
                    @(novo
                        ? "A unidade começa com estoque vazio e já enxerga os itens, categorias e fornecedores cadastrados."
                        : "O novo nome passa a aparecer em todas as telas e relatórios, inclusive nos registros antigos.")
                </div>
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(novo ? "Criar unidade" : "Salvar")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
