# Copie para .env (chmod 600) e troque TODOS os valores. Nunca versione o .env.
# Evite os caracteres ; ' " $ nas senhas (quebram connection string / interpolação do compose).

# --- Banco ---------------------------------------------------------------
# Senha do sa: mín. 8 caracteres e 3 de 4 classes (maiúscula, minúscula, dígito, símbolo)
MSSQL_SA_PASSWORD=TroqueEsta-Senha-SA-123
# Login de menor privilégio usado pela aplicação (estoque_app)
APP_DB_PASSWORD=TroqueEsta-Senha-App-123
# Login de manutenção (estoque_maint): purga de auditoria e monitoramento (Fase 8)
MAINT_DB_PASSWORD=TroqueEsta-Senha-Maint-123

# --- Primeiro administrador (criado só se o banco estiver vazio) -----------
# Senha com 12+ caracteres. Em Production o migrator recusa valores padrão.
SEED_ADMIN_EMAIL=admin@creche.local
SEED_ADMIN_PASSWORD=
# true = tenant de demonstração com itens da planilha, parceiros, usuários
# operacional@<dominio> e visualizador@<dominio> (mesma senha do admin) e movimentações
SEED_DEMO_DATA=true

# --- Aplicação -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# SameAsRequest no ensaio local (HTTP); Always quando usar o profile https
COOKIE_SECURE_POLICY=SameAsRequest
# Endereço/porta do web. 127.0.0.1 = só no servidor. IP da LAN = outros PCs da rede (modo C)
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- Profiles ------------------------------------------------------------
# tools        -> ensaio local com Portainer (servidor caseiro)
# tools,https  -> VPS com Portainer
# https        -> VPS sem Portainer
COMPOSE_PROFILES=tools
PORTAINER_BIND=127.0.0.1

# --- HTTPS (somente profile https, VPS com domínio) ----------------------
SITE_ADDRESS=localhost
ACME_EMAIL=admin@example.com
# Primeiras tentativas: staging do Let's Encrypt (evita bloqueio por limite de emissões)
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# --- Retenção e monitoramento (Fase 8; ainda não usados no MVP) -----------
Retencao__AuditoriaDadosMeses=24
Retencao__AuditoriaAcoesMeses=12
Monitoramento__LimiteBancoGB=50
